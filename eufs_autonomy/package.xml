<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>eufs_autonomy</name>
  <version>0.1.0</version>
  <description>Autonomous driving stack for the EUFS simulator (perception → mapping → planning → control)</description>

  <maintainer email="ferasbabikerjan@gmail.com">Feras Babiker</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ackermann_msgs</depend>

  <!-- Perception -->
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>

  <!-- System deps (rosdep keys) -->
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen</depend>

  <!-- Optional: only keep if you actually use eufs_msgs in code -->
  <!-- <depend>eufs_msgs</depend> -->

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
